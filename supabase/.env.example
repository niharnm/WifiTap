# Edge function secrets. Copy to supabase/functions/.env for local `supabase functions serve`
# (loaded automatically), or set them on a hosted project with `supabase secrets set`.
# Never commit the real file.

# AES-256-GCM key for stored Wi-Fi passwords: base64 of exactly 32 random bytes.
# Generate one with: openssl rand -base64 32
TAG_ENC_KEY=replace-with-output-of-openssl-rand-base64-32

# Origin that NFC cards point at. create-tag returns `${PUBLIC_TAG_BASE_URL}/t/<token>`.
# No trailing slash needed.
PUBLIC_TAG_BASE_URL=https://tap.example.com

# Optional salt mixed into the hashed client address used for redeem-tag rate limiting.
# Any random string; changing it just resets everyone's counters.
RATE_LIMIT_SALT=
