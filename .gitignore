.DS_Store

# Xcode (project is generated from ios/project.yml)
ios/*.xcodeproj/
ios/build/
DerivedData/
xcuserdata/
*.xcuserstate

# Local secrets and test credentials
ios/Config/Local.xcconfig
.env
.env.*
!.env.example

# Apple signing material and API keys
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.pem

# Supabase auth signing keys (see supabase/config.toml)
signing_keys.json

# Swift Package Manager
.build/
.swiftpm/

# Vercel
.vercel/
